{
  "Dashboard": {
    "BindAddress": "0.0.0.0",
    "HttpsPort": 8443,
    "RequireHttps": true,
    "DatabasePath": "C:/TransferUDT/Dashboard/db/dashboard.db",
    "ServerDatabasePath": "C:/TransferUDT/Server/db/server.db",
    "ServerLogPath": "C:/TransferUDT/Server/log/server.log",
    "CertificatePath": "C:/ProgramData/TransferUDT/Dashboard/certs/dashboard.pfx",
    "CertificatePasswordEnv": "TRANSFERUDT_DASHBOARD_CERT_PASSWORD",
    "OperatorPasswordEnv": "TRANSFERUDT_DASHBOARD_OPERATOR_PASSWORD",
    "HeartbeatSkewSeconds": 300,
    "AgentOfflineAfterSeconds": 60,
    "HeartbeatRetentionDays": 30,
    "MetricsWindowHours": 24,
    "MetricsBucketMinutes": 60,
    "LowDiskWarningBytes": 5368709120,
    "AutoRefreshSeconds": 30,
    "AgentPublicKeys": {}
  }
}
